{
  "name": "@relayhistory/object-store",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Read side of RelayHistory's raw session object storage: S3/R2/MinIO, GCS, Azure Blob and local directory adapters, the v1 key layout and manifest validation. Runs in Cloudflare Workers and Node.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
